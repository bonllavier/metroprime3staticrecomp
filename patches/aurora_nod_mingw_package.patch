+      set(_nod_archive "${nod_prebuilt_SOURCE_DIR}/lib/nod_static.lib")
+      if (NOT EXISTS "${_nod_archive}")
+        message(FATAL_ERROR "nod static archive not found: ${_nod_archive}")
+      endif ()
+      add_library(nod::nod STATIC IMPORTED GLOBAL)
