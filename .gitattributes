# Normalize text to LF in the repository; each checkout converts as needed
# (CRLF on Windows with core.autocrlf=true, LF on Linux).
* text=auto

# Windows command scripts need CRLF everywhere.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF even when checked out on Windows.
*.sh text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.bin binary
*.db  binary
*.dol binary
*.rso binary
*.dll binary
*.exe binary
